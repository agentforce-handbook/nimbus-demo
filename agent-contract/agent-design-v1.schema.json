{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentforce-handbook/agent-design-v1",
  "title": "Agentforce Agent Design Contract",
  "description": "Shared data contract for Agentforce Handbook companion skills. Generated by /agentforce:design-agent, consumed by /agentforce:audit-agent and /agentforce:write-evals.",
  "type": "object",
  "required": ["$schema", "agent", "metadata"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "agentforce-handbook/agent-design-v1"
    },
    "agent": {
      "type": "object",
      "required": ["name", "label", "type", "description", "subagents"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Developer name (PascalCase, no spaces). Used as the SFDX bundle name.",
          "pattern": "^[A-Z][a-zA-Z0-9_]+$"
        },
        "label": {
          "type": "string",
          "description": "Human-readable display name for the agent."
        },
        "type": {
          "type": "string",
          "description": "Agentforce agent type.",
          "enum": ["AgentforceServiceAgent", "AgentforceSalesAgent", "AgentforceCustomAgent"]
        },
        "description": {
          "type": "string",
          "description": "What this agent does. Shown in Agent Builder.",
          "minLength": 10
        },
        "welcomeMessage": {
          "type": "string",
          "description": "Greeting shown when the agent first engages a user."
        },
        "errorMessage": {
          "type": "string",
          "description": "Fallback message shown when the agent encounters an unrecoverable error."
        },
        "variables": {
          "type": "array",
          "description": "Conversation-scoped variables shared across subagents.",
          "items": {
            "type": "object",
            "required": ["name", "type", "description"],
            "properties": {
              "name": {
                "type": "string",
                "description": "Variable name (snake_case)."
              },
              "type": {
                "type": "string",
                "enum": ["string", "boolean", "number", "object"]
              },
              "mutable": {
                "type": "boolean",
                "default": true
              },
              "defaultValue": {
                "description": "Default value. Type must match the variable type."
              },
              "description": {
                "type": "string",
                "description": "What this variable holds.",
                "minLength": 1
              }
            }
          }
        },
        "subagents": {
          "type": "array",
          "description": "Subagents that handle distinct areas of responsibility. Each subagent is a separate routing target.",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "classificationDescription", "instructions", "escalationTriggers"],
            "properties": {
              "name": {
                "type": "string",
                "description": "Subagent name (snake_case). Used in Agent Script routing."
              },
              "classificationDescription": {
                "type": "string",
                "description": "Specific, scoped description used for routing. Must be mutually exclusive with other subagents. Describes WHAT the topic handles, not HOW.",
                "minLength": 10
              },
              "instructions": {
                "type": "string",
                "description": "Full instruction text for this subagent. Must be under 1000 words. Lead with the goal, use 'if' conditions not 'always' directives."
              },
              "instructionWordCount": {
                "type": "integer",
                "description": "Word count of instructions. Must be <= 1000.",
                "maximum": 1000
              },
              "actions": {
                "type": "array",
                "description": "Actions available to this subagent. Maximum 6.",
                "maxItems": 6,
                "items": {
                  "type": "object",
                  "required": ["name", "type", "description"],
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Action name (snake_case)."
                    },
                    "type": {
                      "type": "string",
                      "description": "Implementation type.",
                      "enum": ["apex", "flow", "external"]
                    },
                    "description": {
                      "type": "string",
                      "description": "What this action does. Must be specific and descriptive.",
                      "minLength": 10
                    },
                    "target": {
                      "type": "string",
                      "description": "Implementation target. Format: 'apex://ClassName', 'flow://FlowApiName', or 'TODO' for stubs.",
                      "pattern": "^(apex://|flow://|external://|TODO)"
                    },
                    "inputs": {
                      "type": "array",
                      "description": "Action inputs.",
                      "items": {
                        "type": "object",
                        "required": ["name", "type", "description", "required"],
                        "properties": {
                          "name": {
                            "type": "string",
                            "description": "Input parameter name."
                          },
                          "type": {
                            "type": "string",
                            "enum": ["string", "boolean", "number", "object"],
                            "description": "Data type of this input."
                          },
                          "description": {
                            "type": "string",
                            "description": "What this input is. Must not be empty.",
                            "minLength": 1
                          },
                          "required": {
                            "type": "boolean",
                            "description": "Whether this input is required."
                          }
                        }
                      }
                    },
                    "outputs": {
                      "type": "array",
                      "description": "Action outputs.",
                      "items": {
                        "type": "object",
                        "required": ["name", "type", "description"],
                        "properties": {
                          "name": {
                            "type": "string",
                            "description": "Output parameter name."
                          },
                          "type": {
                            "type": "string",
                            "enum": ["string", "boolean", "number", "object"],
                            "description": "Data type of this output."
                          },
                          "description": {
                            "type": "string",
                            "description": "What this output contains. Must not be empty.",
                            "minLength": 1
                          }
                        }
                      }
                    }
                  }
                }
              },
              "escalationTriggers": {
                "type": "array",
                "description": "Conditions under which this subagent should hand off to a human agent.",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["generatedBy", "timestamp"],
      "additionalProperties": false,
      "properties": {
        "generatedBy": {
          "type": "string",
          "description": "Which skill generated this design."
        },
        "handbookVersion": {
          "type": "string",
          "description": "Edition of The Agentforce Handbook this design follows."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When this design was generated."
        }
      }
    }
  }
}
